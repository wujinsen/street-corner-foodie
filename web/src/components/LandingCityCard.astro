---
import { UI, t } from "../lib/i18n";
import type { Lang } from "../lib/i18n";
import type { Multilang } from "../lib/types";

interface Props {
  lang: Lang;
  heroUrl: string | null;
  city: Multilang;
  citySub: Multilang;
  coords: string;
  regionHref: string;
}

const { lang, heroUrl, city, citySub, coords, regionHref } = Astro.props as Props;
const cityDisplay =
  lang === "zh" ? city.zh : lang === "ja" ? city.ja : city.en;
const citySubText = t(citySub, lang).trim();
---

<article class="landing-city-card tile" data-map-city-card>
  <div
    class:list={["landing-city-card-bg", heroUrl && "is-visible"]}
    data-map-city-bg
    style={heroUrl ? `background-image:url('${heroUrl}')` : undefined}
    aria-hidden="true"
  />
  <div class="landing-city-card-inner">
    <div class="label h-track">{t(UI.landing.region_tag, lang)}</div>
    <h2 class="name h-serif-dish">
      <span data-map-city-display>{cityDisplay}</span>
    </h2>
    {citySubText && <p class="sub" data-map-city-sub>{citySubText}</p>}
    <footer class="landing-city-card-foot">
      <span class="coords h-track" data-map-city-coords>{coords}</span>
      <span class="landing-city-social" aria-hidden="true">
        <span class="avatars"><span /><span /><span /></span>
        <span class="count">12.4K</span>
      </span>
      <a class="map-region-cta" data-map-region-link href={regionHref}>
        {lang === "zh" ? "进入区域" : lang === "ja" ? "地域へ" : "Explore"} &rarr;
      </a>
    </footer>
  </div>
</article>
