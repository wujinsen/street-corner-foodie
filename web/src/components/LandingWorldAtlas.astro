---
/**
 * Landing left column · world street atlas (same payload as /world-atlas/).
 * Borderless map only — no crumb / chrome overlays (full UI on /world-atlas/).
 */
import WorldAtlasBoot from "./WorldAtlasBoot.astro";
import { UI, t, type Lang } from "../lib/i18n";
import { buildWorldAtlasPayload, type WorldAtlasPayload } from "../lib/world-atlas-payload";

interface Props {
  lang: Lang;
  payload?: WorldAtlasPayload | null;
}

const { lang, payload: payloadProp } = Astro.props as Props;
const payload = payloadProp ?? buildWorldAtlasPayload(lang);

if (!payload) {
  return null;
}
---

<div
  class="landing-world-atlas map-hero map-hero--map-only"
  aria-label={t(UI.landing.map_label, lang)}
  data-landing-world-atlas
>
  <section
    class="world-atlas-explorer world-atlas-explorer--landing"
    data-world-atlas-explorer
    data-atlas-view="world"
    aria-label={t(UI.nav.world_atlas, lang)}
  >
    <script type="application/json" data-world-atlas-config set:html={JSON.stringify(payload)} />

    <div
      class="world-atlas-explorer__stage world-atlas-explorer__stage--landing"
      data-world-atlas-host
      role="img"
      aria-label={payload.title}
    ></div>
  </section>

  <WorldAtlasBoot />
</div>
