---
/**
 * theme-cn.png · country gallery bottom dock (Posters / Explore / Mini-Zine / Streets / Profile).
 */
import { UI, t, type Lang } from "../lib/i18n";
import { localePath } from "../lib/locale-path";
import type { CountryId } from "../lib/types";

interface Props {
  lang: Lang;
  country: CountryId;
  /** Gallery hash tab synced with topbar + gallery-tabs.ts */
  activeTab?: "posters" | "zines" | "streets";
  /** Base path without hash, e.g. /cn/ or /cn/g/hainan/ */
  basePath: string;
}

const { lang, activeTab = "posters", basePath } = Astro.props as Props;
const exploreLabel = { zh: "探索", en: "Explore", ja: "探索" };
const profileLabel = { zh: "设置", en: "Profile", ja: "設定" };
const tabHref = (kind: "posters" | "zines" | "streets") => `${basePath}#${kind}`;
---
<div class="gallery-dock-rail">
  <div class="dock-wrap gallery-dock-wrap">
  <nav class="dock gallery-dock" aria-label="gallery dock" data-gallery-dock>
    <a
      href={tabHref("posters")}
      class:list={["dock-item", activeTab === "posters" && "active"]}
      data-gallery-dock-tab="posters"
    >
      <span class="dock-ic-wrap" aria-hidden="true">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"/>
          <circle cx="8.5" cy="10" r="1.5"/>
          <path d="M3 16l5-4 4 3 5-5 4 6"/>
        </svg>
      </span>
      <span>{t(UI.nav.poster, lang)}</span>
    </a>
    <a href={localePath(lang, "/")} class="dock-item" data-gallery-dock-tab="explore">
      <span class="dock-ic-wrap" aria-hidden="true">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <path d="M16 8l-2 6-6 2 2-6z"/>
        </svg>
      </span>
      <span>{t(exploreLabel, lang)}</span>
    </a>
    <a
      href={tabHref("zines")}
      class:list={["dock-item", activeTab === "zines" && "active"]}
      data-gallery-dock-tab="zines"
    >
      <span class="dock-ic-wrap" aria-hidden="true">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/>
          <path d="M8 8h8M8 12h8M8 16h5"/>
        </svg>
      </span>
      <span>{t(UI.nav.zine, lang)}</span>
    </a>
    <a
      href={tabHref("streets")}
      class:list={["dock-item", activeTab === "streets" && "active"]}
      data-gallery-dock-tab="streets"
    >
      <span class="dock-ic-wrap" aria-hidden="true">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 20V8l8-5 8 5v12"/>
          <path d="M8 20v-6h8v6"/>
          <path d="M12 3v3"/>
        </svg>
      </span>
      <span>{t(UI.nav.street, lang)}</span>
    </a>
    <button
      type="button"
      id="dock-settings-btn"
      class="dock-item"
      data-gallery-dock-tab="profile"
      aria-label={t(profileLabel, lang)}
    >
      <span class="dock-ic-wrap" aria-hidden="true">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="8" r="4"/>
          <path d="M4 21c1-4 5-6 8-6s7 2 8 6"/>
        </svg>
      </span>
      <span>{t(profileLabel, lang)}</span>
    </button>
  </nav>
  </div>
</div>

<script>
  document.getElementById("dock-settings-btn")?.addEventListener("click", () => {
    document.getElementById("settings-btn")?.dispatchEvent(new MouseEvent("click"));
  });
</script>
