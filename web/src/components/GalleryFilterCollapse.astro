---
/**
 * Mobile: collapsible filter panel (native <details>).
 * Desktop (≥901px): summary hidden, body always visible — see components.css.
 */
import { GALLERY_UI, gt } from "../lib/gallery-ui";
import type { Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  /** Current selection chips shown when collapsed, e.g. 中国 · 海南 · 全部 */
  summaryParts: string[];
}

const { lang, summaryParts } = Astro.props as Props;
const hint = gt(GALLERY_UI.filter_panel_hint, lang);
---
<details class="gallery-filter-collapse" data-gallery-filter-collapse open>
  <summary class="gallery-filter-collapse__summary" aria-label={hint}>
    <span class="gallery-filter-collapse__title h-track">{gt(GALLERY_UI.filter_panel, lang)}</span>
    <span class="gallery-filter-collapse__value" data-filter-summary>
      {summaryParts.map((part, i) => (
        <>
          {i > 0 && <span class="gallery-filter-collapse__sep" aria-hidden="true"> · </span>}
          <span data-filter-summary-part>{part}</span>
        </>
      ))}
    </span>
    <svg
      class="gallery-filter-collapse__chev"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M6 9l6 6 6-6" />
    </svg>
  </summary>
  <div class="gallery-filter-collapse__body">
    <slot />
  </div>
</details>
