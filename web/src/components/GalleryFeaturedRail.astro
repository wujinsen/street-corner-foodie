---
/**
 * v0.6.1 · alt-c · sticky "Tonight's Featured" rail for region gallery.
 */
import { UI, t, type Lang } from "../lib/i18n";
import { GALLERY_UI, gt } from "../lib/gallery-ui";
import { posterImageUrl } from "../lib/posters";
import { posterLinkedScene } from "../lib/streets";
import { localePath, regionGalleryHref } from "../lib/locale-path";
import type { Poster } from "../lib/types";
import type { CountryId } from "../lib/types";
import ScfPicture from "./ScfPicture.astro";

interface Props {
  lang: Lang;
  country: CountryId;
  regionId: string;
  poster: Poster;
  noChar?: boolean;
}

const { lang, country, regionId, poster, noChar = false } = Astro.props as Props;
const img = posterImageUrl(poster, noChar);
const scene = posterLinkedScene(country, regionId, poster.slug);
const zineHref = localePath(lang, `/${country}/${regionId}/zine/${poster.slug}`);
const streetHref = scene
  ? localePath(lang, `/${country}/${regionId}/street/${scene.id}`)
  : regionGalleryHref(lang, country, regionId, { hash: "streets" });
const desc = t(poster.desc, lang) || gt(GALLERY_UI.featured_sub, lang);
---
<aside class="tile gallery-featured" aria-label={t(poster.name, lang)}>
  <figure class="gallery-featured-hero">
    <div class="gallery-featured-img">
      {img ? (
        <ScfPicture
          src={img}
          alt={t(poster.name, lang)}
          loading="eager"
          fetchpriority="high"
          sizes="(min-width: 1100px) min(320px, 30vw), 92vw"
        />
      ) : (
        <div class="gallery-featured-ph" aria-hidden="true">
          <span>{poster.emoji ?? "🍽"}</span>
        </div>
      )}
    </div>
  </figure>

  <div class="gallery-featured-body">
    <h2 class="gallery-featured-name h-display-strong">{t(poster.name, lang)}</h2>
    <p class="gallery-featured-desc">{desc}</p>
    <div class="gallery-featured-actions" role="group" aria-label={t(poster.name, lang)}>
      <button
        type="button"
        class="gallery-action-btn"
        data-fav-slug={poster.slug}
        data-fav-country={poster.countryId}
        data-fav-region={poster.regionId}
        data-fav-name-zh={poster.name.zh}
        data-fav-name-en={poster.name.en}
        data-fav-name-ja={poster.name.ja}
        data-fav-pin={poster.pin}
        data-fav-thumb={img ?? ""}
        aria-label={gt(GALLERY_UI.save, lang)}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span>{gt(GALLERY_UI.save, lang)}</span>
      </button>
      <a class="gallery-action-btn" href={zineHref}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
        </svg>
        <span>{t(UI.landing.read_zine, lang)}</span>
      </a>
      <a class="gallery-action-btn" href={streetHref}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/>
        </svg>
        <span>{t(UI.landing.view_street, lang)}</span>
      </a>
    </div>
  </div>

  {scene && (
    <footer class="gallery-featured-foot">
      <a class="gallery-linked-street" href={streetHref}>
        {gt(GALLERY_UI.linked_street, lang)}: {t(scene.name, lang)} &rarr;
      </a>
    </footer>
  )}
</aside>
