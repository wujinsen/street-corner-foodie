---
/**
 * v0.6 · alt-c · BottomDock
 * Sticky floating glass dock — site-wide bottom navigation (theme-cn / mobile.png).
 * 2026-05-28 · P1：合并原 GalleryBottomDock；全站统一 5 项（探索 · 地图 · 收藏 · 搜索 · 设置）。
 */
import { UI, t, type Lang } from "../lib/i18n";
import { localePath } from "../lib/locale-path";

interface Props {
  lang: Lang;
  /**
   * 2026-05-28 · P5：dock 只把「页面级 tab」做持久 active。
   * - `explore` = 在内容站点中（首页/国家页/地区页/阅读器）
   * - `map`     = 在世界地图页（/world-atlas）
   * 收藏 / 搜索 / 设置都是抽屉触发器（aria-haspopup="dialog"），不该有 page-level active；
   * 它们的点击反馈由 CSS `:active` 即时承担。
   */
  active?: "explore" | "map";
}

const { lang, active } = Astro.props as Props;
const labels = {
  explore: UI.nav.explore,
  map: UI.nav.map,
  saved: UI.fav.title,
  search: UI.search.title,
  profile: UI.settings.title,
} as const;
---
<div class="scf-bottom-stack">
  <div class="dock-wrap">
  <nav class="dock" aria-label={t(UI.a11y.primary, lang)}>
    <span class="dock-tech" aria-hidden="true">
      <span class="dock-tech-grid"></span>
      <span class="dock-tech-scan"></span>
      <span class="dock-tech-dust"></span>
    </span>
    <a
      href={localePath(lang, "/")}
      class:list={["dock-item", active === "explore" && "active"]}
      data-dock="explore"
    >
      <span class="dock-ic-wrap" aria-hidden="true">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <path d="M16 8l-2 6-6 2 2-6z"/>
        </svg>
      </span>
      <span>{t(labels.explore, lang)}</span>
    </a>
    <a
      href={localePath(lang, "/world-atlas")}
      class:list={["dock-item", active === "map" && "active"]}
      data-dock="map"
    >
      <span class="dock-ic-wrap" aria-hidden="true">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 3 L3 6 V21 L9 18 L15 21 L21 18 V3 L15 6 Z"/>
          <path d="M9 3 V18 M15 6 V21"/>
        </svg>
      </span>
      <span>{t(labels.map, lang)}</span>
    </a>
    <button
      type="button"
      id="dock-fav-btn"
      class="dock-item dock-item--drawer"
      aria-label={t(UI.fav.title, lang)}
      aria-haspopup="dialog"
      aria-controls="fav-panel"
    >
      <span class="dock-ic-wrap" aria-hidden="true">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </span>
      <span class="dock-label">{t(labels.saved, lang)}</span>
    </button>
    <button
      type="button"
      id="dock-search-btn"
      class="dock-item dock-item--drawer"
      aria-label={t(UI.search.title, lang)}
      aria-haspopup="dialog"
      aria-controls="search-overlay"
    >
      <span class="dock-ic-wrap" aria-hidden="true">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <path d="M21 21l-4.3-4.3"/>
        </svg>
      </span>
      <span class="dock-label">{t(labels.search, lang)}</span>
    </button>
    <button
      type="button"
      id="dock-settings-btn"
      class="dock-item dock-item--drawer"
      aria-label={t(labels.profile, lang)}
      aria-haspopup="dialog"
      aria-controls="settings-overlay"
    >
      <span class="dock-ic-wrap" aria-hidden="true">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="8" r="4"/>
          <path d="M4 21c1-4 5-6 8-6s7 2 8 6"/>
        </svg>
      </span>
      <span class="dock-label">{t(labels.profile, lang)}</span>
    </button>
  </nav>
  </div>
</div>

<!--
  2026-05-28 · P1：search / fav / settings 直接由 site-chrome.ts / settings-sheet.ts
  统一监听 #dock-search-btn / #dock-fav-btn / #dock-settings-btn（以及兼容旧 id），
  这里无需再 dispatchEvent 转发到 topbar 上的按钮。
-->
