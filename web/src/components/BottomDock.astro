---
/**
 * v0.6 · alt-c · BottomDock
 * Sticky floating glass dock — same chrome as GalleryBottomDock (theme-cn / mobile.png).
 */
import { UI, t, type Lang } from "../lib/i18n";
import { localePath } from "../lib/locale-path";

interface Props {
  lang: Lang;
  /** Which dock item is active: "explore" | "map" | "saved" | "search" | "profile" */
  active?: "explore" | "map" | "saved" | "search" | "profile";
}

const { lang, active } = Astro.props as Props;
const labels = {
  explore: { zh: "探索", en: "Explore", ja: "探索" },
  map: { zh: "地图", en: "Map", ja: "地図" },
  saved: { zh: "收藏", en: "Saved", ja: "保存" },
  search: { zh: "搜索", en: "Search", ja: "検索" },
  profile: { zh: "设置", en: "Settings", ja: "設定" },
} as const;
---
<div class="dock-wrap">
  <nav class="dock" aria-label="primary dock">
    <a
      href={localePath(lang, "/")}
      class:list={["dock-item", active === "explore" && "active"]}
    >
      <span class="dock-ic-wrap" aria-hidden="true">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <path d="M16 8l-2 6-6 2 2-6z"/>
        </svg>
      </span>
      <span>{t(labels.explore, lang)}</span>
    </a>
    <a
      href={localePath(lang, "/world-atlas")}
      class:list={["dock-item", active === "map" && "active"]}
      data-dock="map"
    >
      <span class="dock-ic-wrap" aria-hidden="true">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 3 L3 6 V21 L9 18 L15 21 L21 18 V3 L15 6 Z"/>
          <path d="M9 3 V18 M15 6 V21"/>
        </svg>
      </span>
      <span>{t(labels.map, lang)}</span>
    </a>
    <button
      type="button"
      id="dock-fav-btn"
      class:list={["dock-item", active === "saved" && "active"]}
      aria-label={t(UI.fav.title, lang)}
    >
      <span class="dock-ic-wrap" aria-hidden="true">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </span>
      <span>{t(labels.saved, lang)}</span>
    </button>
    <button
      type="button"
      id="dock-search-btn"
      class:list={["dock-item", active === "search" && "active"]}
      aria-label={t(UI.search.title, lang)}
    >
      <span class="dock-ic-wrap" aria-hidden="true">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <path d="M21 21l-4.3-4.3"/>
        </svg>
      </span>
      <span>{t(labels.search, lang)}</span>
    </button>
    <button
      type="button"
      id="dock-settings-btn"
      class:list={["dock-item", active === "profile" && "active"]}
      aria-label={t(labels.profile, lang)}
    >
      <span class="dock-ic-wrap" aria-hidden="true">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="8" r="4"/>
          <path d="M4 21c1-4 5-6 8-6s7 2 8 6"/>
        </svg>
      </span>
      <span>{t(labels.profile, lang)}</span>
    </button>
  </nav>
</div>

<script>
  document.getElementById("dock-search-btn")?.addEventListener("click", () => {
    document.getElementById("search-btn")?.dispatchEvent(new MouseEvent("click"));
  });
  document.getElementById("dock-fav-btn")?.addEventListener("click", () => {
    document.getElementById("fav-btn")?.dispatchEvent(new MouseEvent("click"));
  });
</script>
