---
import BrandMark from "./BrandMark.astro";
import ThemeToggle from "./ThemeToggle.astro";
import CountryPicker from "./CountryPicker.astro";
import { UI, LANG_LABELS, t, LANGS, type Lang } from "../lib/i18n";
import { REGIONS } from "../lib/countries";
import { COUNTRY_SPOTLIGHT } from "../lib/country-posters";
import { localePath, regionGalleryHref, resolveLang, switchLocalePath } from "../lib/locale-path";
import type { CountryId } from "../lib/types";

interface Crumb { label: string; href?: string; }

interface Props {
  lang: Lang;
  country: CountryId;
  crumbs?: Crumb[];
  /** v0.6: render the glass-styled topbar. v0.5 fallback if false. */
  altc?: boolean;
  navTab?: "posters" | "zines" | "streets";
  /** Highlight world atlas link (/world-atlas). */
  worldAtlasActive?: boolean;
  /** Show world atlas link in top nav (default true on alt-c). */
  showWorldAtlasLink?: boolean;
  /** `country-overview` = /{country}/?region= · `region` = detail pages back to gallery */
  tabScope?: "country-overview" | "region";
  /** Region gallery anchors; defaults to first region with content. */
  tabRegionId?: string;
}

const {
  lang,
  country,
  crumbs = [],
  altc = false,
  navTab,
  worldAtlasActive = false,
  showWorldAtlasLink = altc,
  tabScope = "region",
  tabRegionId,
} = Astro.props as Props;
const pageLang = resolveLang(Astro.currentLocale ?? lang);

const worldAtlasHref = localePath(pageLang, "/world-atlas");
const homeHref = localePath(pageLang, "/");
const logoAriaLabel = `${t(UI.brand, pageLang)} — ${t(UI.nav.home_hint, pageLang)}`;
const logoTitle = t(UI.nav.home_hint, pageLang);

/** v0.6.7: country page uses in-page anchors; region pages use primary region + hash. */
function tabHref(kind: "posters" | "zines" | "streets"): string {
  if (tabScope === "country-overview") {
    const rid =
      tabRegionId ??
      COUNTRY_SPOTLIGHT[country] ??
      (REGIONS[country] ?? [])[0]?.id;
    const params = new URLSearchParams();
    if (rid) params.set("region", rid);
    const qs = params.toString();
    const base = localePath(pageLang, `/${country}/`) + (qs ? `?${qs}` : "");
    const hash = kind === "posters" ? "posters" : kind;
    return `${base}#${hash}`;
  }
  const rid =
    tabRegionId ??
    COUNTRY_SPOTLIGHT[country] ??
    (REGIONS[country] ?? [])[0]?.id;
  if (!rid) return localePath(pageLang, `/${country}/`);
  const hash = kind === "posters" ? "posters" : kind;
  return regionGalleryHref(pageLang, country, rid, { hash });
}

---
<header class={altc ? "topbar topbar-glass" : "topbar"}>
  <div class="container-wide topbar-inner">
    <a
      class:list={["logo", altc && "logo--home"]}
      href={homeHref}
      aria-label={logoAriaLabel}
      title={logoTitle}
    >
      <span class="logo-mark"><BrandMark /></span>
      {altc ? (
        <span class="logo-text logo-text--altc">
          <span class="logo-title">{UI.brand.en}</span>
          <span class="logo-sub">
            {t(UI.brand, pageLang)}
            <span class="logo-home-hint" aria-hidden="true">
              {" · "}{t(UI.nav.home, pageLang)}
            </span>
          </span>
        </span>
      ) : (
        <span class="logo-text">
          <span>{t(UI.brand, pageLang)}</span>
          {pageLang !== "ja" && <span class="ja">{UI.brand.ja}</span>}
          {pageLang === "ja" && <span class="ja">{UI.brand.en}</span>}
        </span>
      )}
    </a>

    {altc && (
      <nav class="topbar-center" aria-label={t(UI.a11y.primary, pageLang)}>
        <span class="topbar-tech" aria-hidden="true">
          <span class="topbar-tech-grid"></span>
          <span class="topbar-tech-scan"></span>
          <span class="topbar-tech-dust"></span>
        </span>
        <a
          href={tabHref("posters")}
          data-topbar-tab="posters"
          class={`tab ${navTab === "posters" ? "active" : ""}`}
          aria-label={t(UI.nav.poster, pageLang)}
        >
          <span class="tab-comet-trail tab-comet-trail--l" aria-hidden="true"></span>
          <span class="tab-comet-trail tab-comet-trail--r" aria-hidden="true"></span>
          <span class="tab-ic-wrap" aria-hidden="true">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="16" rx="2"/>
              <path d="M3 16l5-5 4 4 4-4 5 5"/>
              <circle cx="9" cy="9" r="1.4"/>
            </svg>
          </span>
          <span class="tab-label">{t(UI.nav.poster, pageLang)}</span>
        </a>
        <a
          href={tabHref("zines")}
          data-topbar-tab="zines"
          class={`tab ${navTab === "zines" ? "active" : ""}`}
          aria-label={t(UI.nav.zine, pageLang)}
        >
          <span class="tab-comet-trail tab-comet-trail--l" aria-hidden="true"></span>
          <span class="tab-comet-trail tab-comet-trail--r" aria-hidden="true"></span>
          <span class="tab-ic-wrap" aria-hidden="true">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 5c3.5-1 6.5 0 9 2c2.5-2 5.5-3 9-2v13c-3.5-1-6.5 0-9 2c-2.5-2-5.5-3-9-2z"/>
              <path d="M12 7v13"/>
            </svg>
          </span>
          <span class="tab-label">{t(UI.nav.zine, pageLang)}</span>
        </a>
        <a href={tabHref("streets")} data-topbar-tab="streets" class={`tab ${navTab === "streets" ? "active" : ""}`}>
          <span class="tab-comet-trail tab-comet-trail--l" aria-hidden="true"></span>
          <span class="tab-comet-trail tab-comet-trail--r" aria-hidden="true"></span>
          <span class="tab-ic-wrap" aria-hidden="true">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="9" width="7" height="11"/>
              <rect x="14" y="5" width="7" height="15"/>
              <path d="M3 13h7 M3 17h7 M14 9h7 M14 13h7 M14 17h7"/>
            </svg>
          </span>
          <span class="tab-label">{t(UI.nav.street, pageLang)}</span>
        </a>
        {showWorldAtlasLink && (
          <a
            href={worldAtlasHref}
            class={`tab ${worldAtlasActive ? "active" : ""}`}
            data-world-atlas-link
            aria-label={t(UI.nav.world_atlas, pageLang)}
          >
            <span class="tab-comet-trail tab-comet-trail--l" aria-hidden="true"></span>
            <span class="tab-comet-trail tab-comet-trail--r" aria-hidden="true"></span>
            <span class="tab-ic-wrap" aria-hidden="true">
              <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"/>
                <path d="M3 12h18"/>
                <path d="M12 3a14 14 0 0 1 0 18"/>
                <path d="M12 3a14 14 0 0 0 0 18"/>
              </svg>
            </span>
            <span class="tab-label">{t(UI.nav.world_atlas, pageLang)}</span>
          </a>
        )}
      </nav>
    )}

    {!altc && crumbs.length > 0 && (
      <nav class="crumbs" aria-label={t(UI.a11y.breadcrumbs, pageLang)}>
        {crumbs.map((c, i) => (
          <>
            {i > 0 && <span class="sep">/</span>}
            {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
          </>
        ))}
      </nav>
    )}

    <div class="topbar-actions">
      {altc ? (
        <>
          {/* 2026-05-28 · P1：search / fav 入口由 BottomDock 统一承担，
              topbar 右侧只留：国家 · 语言 · 主题 三类「站点偏好」。
              fav-count 仍需保留（隐藏宿主），供收藏数渲染时挂载。 */}
          <CountryPicker lang={pageLang} country={country} variant="topbar" />
          <div class="switch-glass" role="group" aria-label={t(UI.nav.language, pageLang)}>
            {LANGS.map((l) => (
              <a
                href={switchLocalePath(l, Astro.url)}
                class={l === pageLang ? "active" : ""}
              >{LANG_LABELS[l]}</a>
            ))}
          </div>
          <span class="topbar-theme-desktop"><ThemeToggle lang={pageLang} /></span>
          <span id="fav-count" hidden aria-hidden="true">0</span>
        </>
      ) : (
        <>
          <button type="button" class="icon-btn" id="search-btn" title={t(UI.search.shortcut_title, pageLang)} aria-label={t(UI.search.title, pageLang)}>&#8981;</button>
          <button type="button" class="icon-btn" id="fav-btn" title={t(UI.fav.title, pageLang)} aria-label={t(UI.fav.title, pageLang)}>
            &#9825;<span class="fav-count" id="fav-count">0</span>
          </button>
          <CountryPicker lang={pageLang} country={country} variant="topbar" />
          <div class="switch" role="group" aria-label={t(UI.nav.language, pageLang)}>
            {LANGS.map((l) => (
              <a
                href={switchLocalePath(l, Astro.url)}
                class={l === pageLang ? "active" : ""}
              >{LANG_LABELS[l]}</a>
            ))}
          </div>
        </>
      )}
    </div>
  </div>
</header>

{altc && (
  <script is:inline>
    (function () {
      /* 启动时缓存所有 tab 引用与 metadata，避免每次点击都 querySelectorAll + indexOf */
      var tabsNodeList = document.querySelectorAll(".topbar-glass .topbar-center .tab");
      var tabs = [];
      for (var i = 0; i < tabsNodeList.length; i += 1) {
        var el = tabsNodeList[i];
        var href = el.getAttribute("href") || "";
        var kind = el.hasAttribute("data-world-atlas-link")
          ? "world"
          : href.indexOf("#zines") !== -1
            ? "zines"
            : href.indexOf("#streets") !== -1
              ? "streets"
              : href.indexOf("#posters") !== -1
                ? "posters"
                : null;
        if (kind) tabs.push({ el: el, kind: kind });
      }

      var root = document.documentElement;
      var currentTab = null;

      function setActiveTab(tab) {
        if (currentTab === tab) return;
        currentTab = tab;
        if (tab === "world") {
          root.removeAttribute("data-topbar-tab");
        } else {
          root.setAttribute("data-topbar-tab", tab);
        }
        for (var j = 0; j < tabs.length; j += 1) {
          var t = tabs[j];
          var on = t.kind === tab;
          if (on !== t.el.classList.contains("active")) {
            t.el.classList.toggle("active", on);
          }
        }
      }

      function syncTabFromHash() {
        var h = (location.hash || "").replace("#", "");
        if (h === "zines" || h === "streets" || h === "posters") {
          setActiveTab(h);
          return;
        }
        var forced = document.body.getAttribute("data-nav-tab");
        if (forced === "posters" || forced === "zines" || forced === "streets") {
          setActiveTab(forced);
          return;
        }
        if (!document.querySelector(".topbar-glass .tab[data-world-atlas-link].active")) {
          setActiveTab("posters");
        }
      }

      for (var k = 0; k < tabs.length; k += 1) {
        (function (t) {
          t.el.addEventListener("click", function () {
            /* 同步打 active 类，让旋涡 MutationObserver 立即调度迁移 */
            setActiveTab(t.kind);
          });
        })(tabs[k]);
      }

      syncTabFromHash();
      window.addEventListener("hashchange", syncTabFromHash);
    })();
  </script>
)}
