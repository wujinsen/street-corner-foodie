---
/** Client boot for /world-atlas (independent ECharts world atlas). */
---
<script>
  import { initWorldAtlasExplorer } from "../scripts/world-atlas-echarts";
  import { initWorldAtlasWeather } from "../scripts/world-atlas-weather";

  function bootWorldAtlas(): void {
    initWorldAtlasWeather();
    document
      .querySelectorAll<HTMLElement>("[data-world-atlas-explorer]")
      .forEach((root) => {
        initWorldAtlasExplorer(root);
      });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootWorldAtlas, { once: true });
  } else {
    bootWorldAtlas();
  }
</script>
