---
import FlavorRadar from "./FlavorRadar.astro";
import GlassTile from "./GlassTile.astro";
import LandingBentoCarousel from "./LandingBentoCarousel.astro";
import WeatherMascot from "./WeatherMascot.astro";
import { UI, t, type Lang } from "../lib/i18n";
import { regionGalleryHref } from "../lib/locale-path";
import { getRegionAtmosphereGeo, geoPlaceLabel } from "../lib/region-atmosphere-geo";
import { inferWeatherPeriod } from "../lib/weather-chip";
import { inferWeatherMascotState } from "../lib/weather-mascot";
import WeatherExpandIcon from "./WeatherExpandIcon.astro";
import type { LandingSpotPayload } from "../lib/landing-spot-payload";

interface Props {
  lang: Lang;
  payload: LandingSpotPayload;
  bentoPrevLabel: string;
  bentoNextLabel: string;
}

const { lang, payload, bentoPrevLabel, bentoNextLabel } = Astro.props as Props;

const {
  countryId,
  regionId,
  flag,
  editorPick,
  zinePick,
  atmosphere,
  dishSlides,
  zineSlides,
  radarScores,
  flavorLabels,
} = payload;

const posterListHref = regionGalleryHref(lang, countryId, regionId, { hash: "posters" });
const zineListHref = regionGalleryHref(lang, countryId, regionId, { hash: "zines" });
const atmosphereGeo = getRegionAtmosphereGeo(countryId, regionId);
const weatherConfigJson =
  atmosphere && atmosphereGeo
    ? JSON.stringify({
        lat: atmosphereGeo.lat,
        lon: atmosphereGeo.lon,
        timezone: atmosphereGeo.timezone,
        regionKey: `${countryId}/${regionId}`,
        lang,
        climatePreset: atmosphere.climatePreset,
        placeZh: atmosphereGeo.place.zh,
        placeEn: atmosphereGeo.place.en,
        placeJa: atmosphereGeo.place.ja,
      })
    : null;

const weatherPeriod = atmosphereGeo ? inferWeatherPeriod(new Date(), atmosphereGeo.timezone) : "dusk";
const weatherSky = "clear";
const weatherClimate = atmosphere?.climatePreset ?? "temperate";
const weatherPlaceLabel = atmosphereGeo ? geoPlaceLabel(atmosphereGeo, lang) : "";
const weatherMascotSsr = inferWeatherMascotState({
  tempC: null,
  period: weatherPeriod,
  climate: weatherClimate,
});
---

<div class="right-bento landing-bento-mosaic landing-bento-mosaic--4" data-landing-bento-mosaic>
  {editorPick && (
    <GlassTile
      as="a"
      href={posterListHref}
      variant="feature"
      class="bento-dish bento-dish--proto"
      ariaLabel={`${t(editorPick.name, lang)} · ${t(UI.nav.poster, lang)}`}
    >
      <div class="photo">
        {dishSlides.length > 0 && (
          <LandingBentoCarousel
            slides={dishSlides}
            variant="photo"
            eager
            prevLabel={bentoPrevLabel}
            nextLabel={bentoNextLabel}
          />
        )}
        <span class="bento-flag" aria-hidden="true">{flag}</span>
      </div>
      <div class="bento-media-grad" aria-hidden="true"></div>
      <div class="bento-dish-copy">
        <div class="n-zh h-serif-dish">{dishSlides[0]?.title ?? t(editorPick.name, lang)}</div>
      </div>
    </GlassTile>
  )}

  {zinePick && (
    <GlassTile
      as="a"
      href={zineListHref}
      variant="feature"
      class="bento-zine bento-zine--proto"
      ariaLabel={`${t(zinePick.name, lang)} · ${t(UI.nav.zine, lang)}`}
    >
      <div class="photo">
        {zineSlides.length > 0 && (
          <LandingBentoCarousel
            slides={zineSlides}
            variant="photo"
            prevLabel={bentoPrevLabel}
            nextLabel={bentoNextLabel}
          />
        )}
      </div>
      <div class="bento-media-grad" aria-hidden="true"></div>
      <span class="bento-flag" aria-hidden="true">{flag}</span>
      <div class="bento-zine-copy">
        <div class="n-zh h-serif-dish">{zineSlides[0]?.title ?? t(zinePick.name, lang)}</div>
        <span class="bento-zine-read">
          {t(UI.landing.read_short, lang)} &rarr;
        </span>
      </div>
    </GlassTile>
  )}

  {flavorLabels.length > 0 && radarScores.length > 0 && (
    <GlassTile variant="chip" class="bento-radar bento-radar--proto bento-radar--fill t-radar" ariaLabel={t(UI.detail.flavors, lang)}>
      <FlavorRadar flavorLabels={flavorLabels} scores={radarScores} lang={lang} altc compact fx bentoFill />
    </GlassTile>
  )}

  <div class="landing-bento-right-col">
    {atmosphere && (
      <GlassTile
        variant="chip"
        class="bento-weather bento-weather--proto"
        ariaLabel={t(UI.gallery.atmosphere_hint, lang)}
        title={t(UI.gallery.atmosphere_hint, lang)}
      >
        <div
          class:list={["bento-weather-live", "bento-weather-live--starfield"]}
          data-landing-weather={weatherConfigJson ? "" : undefined}
          data-weather-config={weatherConfigJson ?? undefined}
          data-weather-period={weatherPeriod}
          data-weather-sky={weatherSky}
          data-weather-climate={weatherClimate}
          data-weather-mascot={weatherMascotSsr}
          data-weather-temp-fx-debug="cycle"
        >
          <div class="bento-weather-bg" aria-hidden="true">
            <div class="bento-weather-mesh"></div>
            <canvas
              class="bento-weather-fx-canvas"
              data-weather-temp-fx-canvas
              hidden
              aria-hidden="true"
            ></canvas>
            <div class="bento-weather-fx-stage" data-weather-temp-fx-stage aria-hidden="true">
              <div class="bento-weather-fx-stage__wash" data-weather-temp-fx-wash aria-hidden="true"></div>
              <div class="bento-weather-fx-stage__bubbles" data-weather-temp-fx-bubbles aria-hidden="true"></div>
              <div class="bento-weather-fx-stage__hands" data-weather-temp-fx-hands hidden aria-hidden="true">
                <svg viewBox="0 0 120 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path
                    class="bento-weather-fx-hand-l"
                    d="M8 36c6-12 16-18 28-18 5 0 10 2 14 5"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                  />
                  <path
                    class="bento-weather-fx-hand-r"
                    d="M112 36c-6-12-16-18-28-18-5 0-10 2-14 5"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                  />
                </svg>
              </div>
            </div>
            <div class="bento-weather-fx-scrim" data-weather-temp-fx-scrim aria-hidden="true"></div>
            <div class="bento-weather-hover-light"></div>
            <div class="bento-weather-fx bento-weather-fx--particles"></div>
            <div class="bento-weather-fx bento-weather-fx--glow"></div>
          </div>
          <div class="bento-weather-body">
            <button
              type="button"
              class="bento-weather-toggle"
              data-bento-weather-toggle
              aria-expanded="false"
              aria-controls="bento-weather-forecast"
              aria-label={t(UI.gallery.weather_expand, lang)}
              data-label-expand={t(UI.gallery.weather_expand, lang)}
              data-label-collapse={t(UI.gallery.weather_collapse, lang)}
            >
              <span class="bento-weather-icon bento-weather-icon--compass" aria-hidden="true">
                <WeatherExpandIcon />
              </span>
            </button>
            <div class="bento-weather-copy">
              <div class="bento-weather-main" data-bento-weather-main>
                <span class="bento-weather-climate" data-bento-weather-climate>{t(atmosphere.climate, lang)}</span>
                <span class="bento-weather-temp-line">
                  <span
                    class="bento-weather-temp-hit"
                    data-bento-weather-temp-hit
                    tabindex="0"
                    role="button"
                    aria-label={t(UI.gallery.weather_temp_poke, lang)}
                  >
                    <span class="bento-weather-temp" data-bento-weather-temp aria-busy="true">—</span>
                  </span>
                  <span class="bento-weather-degree" aria-hidden="true">°</span>
                </span>
              </div>
              <div class="bento-weather-sub" data-bento-weather-sub aria-live="polite">
                <span class="bento-weather-live-dot" data-bento-weather-live-dot hidden aria-hidden="true"></span>
                <span class="bento-weather-ambient-dot" data-bento-weather-ambient-dot hidden aria-hidden="true"></span>
                {t(UI.gallery.weather_loading, lang)}{weatherPlaceLabel ? ` · ${weatherPlaceLabel}` : ""}
              </div>
              <p class="bento-weather-mood" data-bento-weather-mood hidden></p>
            </div>
            <WeatherMascot />
            <span class="bento-weather-temp-fx-gel-badge" data-weather-temp-fx-gel-badge hidden aria-hidden="true">
              {t(UI.gallery.weather_fx_gel_label, lang)}
            </span>
          </div>
          <div
            class="bento-weather-panel"
            id="bento-weather-forecast"
            data-bento-weather-forecast
            hidden
          ></div>
        </div>
      </GlassTile>
    )}
    <slot name="manifesto" />
  </div>
</div>
