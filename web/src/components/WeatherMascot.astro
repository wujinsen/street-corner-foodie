---
/** Corner mascot for landing weather chip · states toggled via data-weather-mascot on parent. */
---

<div class="bento-weather-mascot" aria-hidden="true">
  <svg class="bento-weather-mascot__svg" viewBox="0 0 72 72" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- idle: tiny wave -->
    <g class="weather-mascot__scene weather-mascot__scene--idle">
      <circle cx="36" cy="22" r="7" stroke="currentColor" stroke-width="1.5" />
      <path d="M28 38c2-3 5-5 8-5s6 2 8 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path
        class="weather-mascot__wave-arm"
        d="M44 34c3 1 5 3 6 6"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      />
      <path d="M30 52h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.5" />
    </g>

    <!-- hot: shades + beach chair + coconut -->
    <g class="weather-mascot__scene weather-mascot__scene--hot">
      <path d="M14 54h34" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.45" />
      <path
        d="M22 54V46c0-2 2-4 5-4h8c3 0 5 2 5 4v8"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linejoin="round"
      />
      <path d="M20 54h22" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
      <circle cx="48" cy="18" r="5" stroke="currentColor" stroke-width="1.2" opacity="0.55" />
      <circle cx="34" cy="28" r="6.5" stroke="currentColor" stroke-width="1.5" />
      <path d="M29 27h10M31 26v2M39 26v2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
      <path
        d="M28 36c1.5-2.5 4-4 6.5-4s5 1.5 6.5 4"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      />
      <ellipse cx="52" cy="40" rx="4" ry="5" stroke="currentColor" stroke-width="1.3" />
      <path d="M52 35v-6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
      <path
        class="weather-mascot__fan"
        d="M24 36c-2 2-3 5-2 8"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
      />
    </g>

    <!-- cold: bundled + shiver + breath -->
    <g class="weather-mascot__scene weather-mascot__scene--cold">
      <g class="weather-mascot__shiver">
        <ellipse cx="36" cy="38" rx="11" ry="13" stroke="currentColor" stroke-width="1.5" />
        <path d="M28 32h16M27 38h18M28 44h16" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" opacity="0.65" />
        <circle cx="36" cy="22" r="6" stroke="currentColor" stroke-width="1.5" />
        <path d="M33 20h6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
      </g>
      <circle class="weather-mascot__breath weather-mascot__breath--a" cx="48" cy="20" r="2.5" fill="currentColor" opacity="0.35" />
      <circle class="weather-mascot__breath weather-mascot__breath--b" cx="52" cy="16" r="2" fill="currentColor" opacity="0.25" />
    </g>

    <!-- dusk: railing + sunset lean -->
    <g class="weather-mascot__scene weather-mascot__scene--dusk">
      <path d="M8 50h56" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.55" />
      <path d="M8 50V44M56 50V44" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" opacity="0.45" />
      <path
        class="weather-mascot__sun-disc"
        d="M54 28a6 6 0 1 1-12 0a6 6 0 0 1 12 0"
        stroke="currentColor"
        stroke-width="1.3"
        opacity="0.7"
      />
      <path d="M48 34h12" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.35" />
      <g class="weather-mascot__lean">
        <circle cx="30" cy="30" r="5.5" stroke="currentColor" stroke-width="1.5" />
        <path
          d="M24 36c2-2 4-3 6-3s4 1 6 3"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        />
        <path d="M36 36l8-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        <path d="M44 30v20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.7" />
      </g>
    </g>
  </svg>
</div>
